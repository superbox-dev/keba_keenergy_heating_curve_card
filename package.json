{
  "name": "keba-keenergy-heating-curve-card",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Reusable Home Assistant heating curve card for superbox-dev/keba_keenergy",
  "license": "MIT",
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run --config test/vitest.config.js",
    "test:coverage": "vitest run --config test/vitest.config.js --coverage",
    "test:dist": "npm run build && vitest run --config test/vitest.dist.config.js",
    "test:e2e": "vitest run --config test/vitest.e2e.config.js",
    "test:ha": "npm run build && vitest run --config test/vitest.ha.config.js",
    "typecheck": "tsc",
    "prepare": "prek install && node scripts/install-hooks.mjs"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@j178/prek": "0.5.11",
    "@stylistic/eslint-plugin": "6.0.1",
    "@vitest/browser-playwright": "5.1.1",
    "@vitest/coverage-v8": "5.1.1",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "home-assistant-js-websocket": "9.9.0",
    "jsdom": "31.0.1",
    "playwright": "1.65.1",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  },
  "allowScripts": {
    "esbuild": true
  }
}
